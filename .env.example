# Anthropic API key. If unset, the app runs in demo mode with deterministic
# templated briefings — useful for screen recordings without exposing a key.
ANTHROPIC_API_KEY=

# Optional: pin a specific model. Defaults to claude-sonnet-4-6.
# ANTHROPIC_MODEL_ID=claude-sonnet-4-6

# Required in production for /api/morning-broadcast (the Make.com / n8n
# webhook). If unset, the endpoint is open — useful for recruiters poking at
# the public demo, but you should set this before wiring real automations.
# BRADEN_WEBHOOK_SECRET=

# Optional. The base URL embedded in delivery payloads (deep-links back to
# the briefing detail page). Vercel sets VERCEL_URL automatically; set this
# only if you want to override it.
# NEXT_PUBLIC_APP_URL=https://braden-ops-copilot.vercel.app
